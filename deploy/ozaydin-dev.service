# Gunicorn servisi: siteyi arka planda çalıştırır, sunucu açılınca kendiliğinden başlar.
# Kurulum: sudo cp deploy/ozaydin-dev.service /etc/systemd/system/
[Unit]
Description=ozaydin.dev (Gunicorn)
After=network.target postgresql.service

[Service]
User=emre
Group=www-data
WorkingDirectory=/srv/ozaydin-dev
EnvironmentFile=/etc/ozaydin-dev.env
RuntimeDirectory=ozaydin-dev
RuntimeDirectoryMode=0750
ExecStart=/srv/ozaydin-dev/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind unix:/run/ozaydin-dev/gunicorn.sock \
    --umask 007 \
    --access-logfile -
Restart=on-failure

[Install]
WantedBy=multi-user.target
